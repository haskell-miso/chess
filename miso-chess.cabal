cabal-version:          3.0
name:                   miso-chess
version:                0.2.0.0
synopsis:               Chess against a built-in engine, built with miso
homepage:               https://chess.haskell-miso.org
license:                BSD-3-Clause
author:                 dmjio
maintainer:             code@dmj.io
category:               Game
build-type:             Simple

executable app
  if arch(wasm32)
    cpp-options:
      -DWASM
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"

  hs-source-dirs:       src
  main-is:              Main.hs
  other-modules:        Chess
                        Drag
                        Engine
                        Model
                        Pieces
                        Sound
                        Styles
  build-depends:        base, containers, miso
  ghc-options:          -Wall -O2
  default-language:     GHC2021
  default-extensions:   CPP
                        LambdaCase
                        MultiWayIf
                        OverloadedStrings
                        QuasiQuotes
                        RecordWildCards
                        TupleSections
                        ViewPatterns

test-suite spec
  if arch(wasm32)
    buildable:          False
  type:                 exitcode-stdio-1.0
  main-is:              Spec.hs
  hs-source-dirs:       tests, src
  other-modules:        Chess
                        Engine
  build-depends:        base, containers
  ghc-options:          -Wall -O2
  default-language:     GHC2021
  default-extensions:   LambdaCase
                        MultiWayIf
                        TupleSections
